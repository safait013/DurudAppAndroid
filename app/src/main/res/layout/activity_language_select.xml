<?xml version="1.0" encoding="utf-8"?>
<!-- First-launch language selection screen (English / বাংলা / اردو) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="☪"
        android:textColor="@color/gold"
        android:textSize="40sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="@string/choose_language_title"
        android:textColor="@color/green_deep"
        android:textSize="21sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_lang_en"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_language_option"
        android:padding="14dp"
        android:text="@string/lang_name_en"
        android:textColor="#F0D080"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_lang_bn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_language_option"
        android:padding="14dp"
        android:text="@string/lang_name_bn"
        android:textColor="#F0D080"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_lang_ur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_language_option"
        android:padding="14dp"
        android:text="@string/lang_name_ur"
        android:textColor="#F0D080"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>